{
  "name": "animate-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "analyze:real-site": "vitest run tests/real_world_extraction_pilot.test.ts",
    "analyze:batch": "vitest run tests/phase19_workbench_and_python_lab.test.ts",
    "analyze:external": "vitest run tests/phase23_external_generalization.test.ts --testNamePattern=\"13. Executes full production external-site forensic observation and independent certification\"",
    "analyze:external-batch": "vitest run tests/phase23_external_generalization.test.ts",
    "verify:provenance": "vitest run tests/phase23_external_generalization.test.ts --testNamePattern=\"Provenance\"",
    "verify:determinism": "vitest run tests/phase23_external_generalization.test.ts --testNamePattern=\"Determinism\"",
    "certify:independent": "vitest run tests/phase23_external_generalization.test.ts --testNamePattern=\"Independent\"",
    "benchmark:23b": "vitest run tests/phase23b_adversarial_benchmark.test.ts",
    "benchmark:23c": "vitest run tests/phase23c_blind_benchmark.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "6.2.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  }
}
